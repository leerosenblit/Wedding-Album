# Firebase web app config (Firebase console → Project settings → Your apps).
# These are public identifiers, not secrets, but keep the API key restricted by HTTP referrer.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=wedding-album-b0cf7.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wedding-album-b0cf7
VITE_FIREBASE_STORAGE_BUCKET=wedding-album-b0cf7.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA Enterprise site key (Firebase console → App Check → Apps).
# Leave empty to skip App Check locally.
VITE_RECAPTCHA_SITE_KEY=

# Shared code printed on the QR cards. A UX gate only, not a security boundary.
# Leave empty to disable the gate.
VITE_EVENT_CODE=

# Public URL of the site, used to build the QR code link.
VITE_SITE_URL=https://wedding-album-b0cf7.web.app

# Set to "true" to talk to local emulators (firebase emulators:start).
VITE_USE_EMULATORS=false
